{
  "builds": [
    {
      "src": "AI-Adaptive-Onboarding-Engine/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)\\.(.*)",
      "destination": "/AI-Adaptive-Onboarding-Engine/frontend/$1.$2"
    },
    {
      "source": "/(.*)",
      "destination": "/AI-Adaptive-Onboarding-Engine/frontend/index.html"
    }
  ]
}

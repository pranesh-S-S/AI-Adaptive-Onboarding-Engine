{
  "builds": [
    {
      "src": "AI-Adaptive-Onboarding-Engine/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "AI-Adaptive-Onboarding-Engine/backend/api.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/analyze",
      "destination": "/AI-Adaptive-Onboarding-Engine/backend/api.py"
    },
    {
      "source": "/(.*)",
      "destination": "/AI-Adaptive-Onboarding-Engine/frontend/$1"
    }
  ]
}
